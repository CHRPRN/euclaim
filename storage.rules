rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /applications/{applicationId}/{docId}/{allPaths=**} {
      allow read, write: if request.auth != null; // In production, we should restrict to the owner of the application
    }
    match /claims/{claimId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data != null;
    }
  }
}
